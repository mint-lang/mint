type Config {
  baseUrl : String
}

type Logger {
  log : Function(String, Void)
}

module Http {
  fun get (path : String) : String {
    with config : Config, logger : Logger {
      logger.log("GET " + path)
      config.baseUrl + path
    }
  }
}

module Users {
  fun load (id : String) : String {
    Http.get("/users/" + id)
  }
}

component Main {
  fun render : Html {
    provide { config: { baseUrl: "https://staging" } } {
      <Page/>
    }
  }
}

component Page {
  fun handleClick (event : Html.Event) : String {
    Users.load("1")
  }

  fun render : Html {
    <div onClick={handleClick}/>
  }
}

type Config {
  baseUrl : String
}

type Logger {
  log : Function(String, Void)
}

module Api {
  fun get (path : String) : String {
    with config : Config, logger : Logger {
      logger.log(path)
      config.baseUrl + path
    }
  }
}

module Users {
  fun load (id : String) : String {
    Api.get(id)
  }
}

module Admin {
  fun load (id : String) : String {
    Users.load(id)
  }
}

module Pages {
  fun admin : String {
    Admin.load("1")
  }
}

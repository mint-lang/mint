type Logger {
  prefix : String
}

module Api {
  fun get (path : String) : String {
    with logger : Logger {
      logger.prefix + path
    }
  }
}

module Users {
  fun load (id : String) : String {
    with logger : Logger {
      provide { logger: { prefix: logger.prefix + "[users] " } } {
        Api.get("/users/" + id)
      }
    }
  }
}

component Main {
  fun render : String {
    provide { logger: { prefix: "" } } {
      Users.load("1")
    }
  }
}

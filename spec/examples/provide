----------------------------------------------------------provide_type_mismatch
type Maybe(a) {
  Nothing
  Just(a)
}

type Theme {
  color : String
}

module Other {
  fun name : String {
    with theme : String {
      theme
    }
  }
}

component Child {
  fun color : String {
    with theme : Theme {
      theme.color
    }
  }

  fun render : Html {
    <div/>
  }
}

component Main {
  fun handleClick : String {
    provide { theme: "dark" } {
      Other.name() + case child {
        Maybe.Just(item) => item.color()
        Maybe.Nothing => ""
      }
    }
  }

  fun render : Html {
    provide { theme: { color: "red" } } {
      <div onClick={handleClick}>
        <Child as child/>
      </div>
    }
  }
}

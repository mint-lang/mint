type Config {
  baseUrl : String
}

module Test {
  // Returns the base url.
  fun url : String {
    with config : Config {
      config.baseUrl
    }
  }

  fun admin : String {
    provide { config: { baseUrl: "/admin" } } {
      url()
    }
  }
}

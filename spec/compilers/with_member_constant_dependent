type Theme {
  color : String
}

component Consumer {
  with theme : Theme

  const COLOR = theme.color
  const LABEL = COLOR + "!"
  const OTHER = LABEL + "?"
  const SIZE = "big"

  fun render : Html {
    <span>OTHER + SIZE</span>
  }
}

component Main {
  fun render : Html {
    provide { theme: { color: "red" } } {
      <Consumer/>
    }
  }
}

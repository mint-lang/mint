type Config {
  baseUrl : String
}

type Logger {
  log : Function(String, Void)
}

module Array {
  fun map (array : Array(a), function : Function(a, b)) : Array(b) {
    `#{array}.map(#{function})`
  }
}

module Http {
  fun get (path : String) : String {
    with config : Config, logger : Logger {
      logger.log("GET " + path)
      config.baseUrl + path
    }
  }
}

module Users {
  fun load (id : String) : String {
    Http.get("/users/" + id)
  }

  fun loadAll (ids : Array(String)) : Array(String) {
    Array.map(ids, (id : String) { load(id) })
  }
}

module Admin {
  fun load (id : String) : String {
    provide { config: { baseUrl: "https://admin" } } {
      Users.load(id)
    }
  }
}

component Main {
  fun render : Html {
    provide {
      config: { baseUrl: "https://staging" },
      logger: { log: (message : String) { void } }
    } {
      <div>
        Admin.load("1")
        Users.loadAll(["1", "2"])
        Array.map(["3"], Users.load)
      </div>
    }
  }
}

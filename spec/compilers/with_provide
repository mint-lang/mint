type Config {
  username : String,
  password : String
}

module Test {
  fun something : String {
    with config : Config {
      config.username
    }
  }
}

component Main {
  fun render : Html {
    provide { config: { username: "admin", password: "admin" } } {
      <div>Test.something()</div>
    }
  }
}

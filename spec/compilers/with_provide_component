type Config {
  baseUrl : String
}

type Logger {
  log : Function(String, Void)
}

module Users {
  fun load (id : String) : String {
    with config : Config, logger : Logger {
      logger.log(id)
      config.baseUrl + id
    }
  }
}

component Main {
  fun render : Html {
    provide {
      config: { baseUrl: "https://staging" },
      logger: { log: (message : String) { void } }
    } {
      <Page/>
    }
  }
}

component Page {
  fun handleClick (event : Html.Event) : String {
    Users.load("1")
  }

  fun render : Html {
    <div onClick={handleClick}>
      <UserCard id="1"/>
    </div>
  }
}

component UserCard {
  property id : String

  fun render : Html {
    <div>Users.load(id)</div>
  }
}

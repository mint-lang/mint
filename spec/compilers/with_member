type Ui {
  theme : String
}

component Button {
  with ui : Ui

  property label : String = ui.theme

  fun inner : String {
    ui.theme
  }

  fun render : Html {
    <button class={ui.theme}>
      label
      inner()

      provide { ui: { theme: "inner" } } {
        inner()
      }
    </button>
  }
}

component Main {
  fun render : Html {
    provide { ui: { theme: "dark" } } {
      <Button/>
    }
  }
}

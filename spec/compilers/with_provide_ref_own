type Logger {
  name : String
}

type Maybe(a) {
  Nothing
  Just(a)
}

module Log {
  fun name : String {
    with logger : Logger {
      logger.name
    }
  }
}

component Child {
  with logger : Logger

  fun who : String {
    logger.name
  }

  fun render : Html {
    <span/>
  }
}

component Parent {
  fun handle : String {
    Log.name() + case child {
      Maybe.Just(item) => item.who()
      Maybe.Nothing => ""
    }
  }

  fun render : Html {
    <div onClick={handle}>
      provide { logger: { name: "child" } } {
        <Child as child/>
      }
    </div>
  }
}

component Main {
  fun render : Html {
    provide { logger: { name: "parent" } } {
      <Parent/>
    }
  }
}

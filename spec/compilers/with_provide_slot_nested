type Form {
  name : String
}

type Theme {
  color : String
}

component Field {
  fun render : Html {
    with form : Form, theme : Theme {
      <input name={form.name} class={theme.color}/>
    }
  }
}

component Card {
  property children : Array(Html) = []

  fun render : Html {
    provide { theme: { color: "red" } } {
      <div>children</div>
    }
  }
}

component Form {
  property children : Array(Html) = []

  fun render : Html {
    provide { form: { name: "form" } } {
      <Card>children</Card>
    }
  }
}

component Main {
  fun render : Html {
    <Form>
      <Field/>
    </Form>
  }
}

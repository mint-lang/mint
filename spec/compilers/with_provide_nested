type Config {
  baseUrl : String
}

module Test {
  fun url : String {
    with config : Config {
      config.baseUrl
    }
  }

  fun admin : String {
    with config : Config {
      provide { config: { config | baseUrl: config.baseUrl + "/admin" } } {
        Test.url()
      }
    }
  }
}

component Main {
  fun render : Html {
    provide { config: { baseUrl: "https://example.com" } } {
      <div>
        Test.url()

        provide { config: { baseUrl: "https://other.com" } } {
          Test.admin()
        }
      </div>
    }
  }
}

type Theme {
  color : String
}

component Consumer {
  with theme : Theme

  const COLOR = theme.color
  const SIZE = "big"

  fun render : Html {
    <span>COLOR + SIZE</span>
  }
}

component Main {
  fun render : Html {
    provide { theme: { color: "red" } } {
      <Consumer/>
    }
  }
}

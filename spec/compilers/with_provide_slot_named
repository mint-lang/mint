type Theme {
  color : String
}

component Label {
  fun render : Html {
    with theme : Theme {
      <span>theme.color</span>
    }
  }
}

component Card {
  property header : Html = <div/>

  fun render : Html {
    <div>
      provide { theme: { color: "red" } } {
        header
      }
    </div>
  }
}

component Main {
  fun render : Html {
    <div>
      <Card header={<Label/>}/>
      <Card/>
    </div>
  }
}

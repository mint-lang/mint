type Theme {
  color : String
}

component Consumer {
  with theme : Theme

  const A = theme.color

  fun label : String {
    A + "!"
  }

  get shout : String {
    label() + "!"
  }

  const B = label()
  const C = shout

  fun render : Html {
    <span>B + C</span>
  }
}

component Main {
  fun render : Html {
    provide { theme: { color: "red" } } {
      <Consumer/>
    }
  }
}

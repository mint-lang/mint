type Graphic {
  Progress(Progress)
  None
}

type Progress {
  Progress(Number)
  Indefinite
}

component Main {
  fun render : String {
    case Graphic.Progress(Progress.Indefinite) {
      Progress(Indefinite) => "indefinite"
      Progress(Progress) => "progress"
      None => "none"
    }
  }
}

type Config {
  baseUrl : String
}

store Test {
  get url : String {
    with config : Config {
      config.baseUrl
    }
  }
}

component Main {
  connect Test exposing { url }

  fun render : Html {
    provide { config: { baseUrl: "https://example.com" } } {
      <div>url</div>
    }
  }
}
--------------------------------------------------------------------------------

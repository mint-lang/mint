type Depth {
  max : Number
}

module Test {
  fun count (value : Number) : Number {
    with depth : Depth {
      if value > depth.max {
        value
      } else {
        count(value + 1)
      }
    }
  }
}

component Main {
  fun render : Html {
    provide { depth: { max: 10 } } {
      <div>Number.toString(Test.count(0))</div>
    }
  }
}

module Number {
  fun toString (value : Number) : String {
    `#{value}.toString()`
  }
}
